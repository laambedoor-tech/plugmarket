# Copy this file to .env and fill with your secrets for local development
# Netlify dev will automatically load variables from .env

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# When using Stripe CLI, it prints a signing secret; paste it here before running
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-service-role-key
